{
  "swagger": "2.0",
  "info": { "title": "Swagger 2 QA fixture", "version": "1.0.0" },
  "host": "api.example.test",
  "basePath": "/v2",
  "schemes": ["https"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "basicAuth": { "type": "basic" },
    "apiKeyAuth": { "type": "apiKey", "name": "X-API-Key", "in": "header" },
    "oauth": {
      "type": "oauth2",
      "flow": "accessCode",
      "authorizationUrl": "https://auth.example.test/authorize",
      "tokenUrl": "https://auth.example.test/token",
      "scopes": { "read": "Read access" }
    }
  },
  "definitions": {
    "User": {
      "type": "object",
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "name": { "type": "string" },
        "manager": { "$ref": "#/definitions/User" }
      }
    },
    "UserList": {
      "type": "array",
      "items": { "$ref": "#/definitions/User" }
    }
  },
  "paths": {
    "/users": {
      "get": {
        "operationId": "listUsers",
        "summary": "List users",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "type": "integer",
            "format": "int32",
            "default": 1,
            "required": false
          },
          {
            "name": "X-Trace",
            "in": "header",
            "type": "string",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "a list of users",
            "schema": { "$ref": "#/definitions/UserList" }
          }
        }
      },
      "post": {
        "operationId": "createUser",
        "summary": "Create a user",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": { "$ref": "#/definitions/User" }
          }
        ],
        "responses": {
          "201": { "description": "created", "schema": { "$ref": "#/definitions/User" } }
        }
      }
    },
    "/users/{id}/avatar": {
      "post": {
        "operationId": "uploadAvatar",
        "summary": "Upload an avatar",
        "consumes": ["multipart/form-data"],
        "parameters": [
          { "name": "id", "in": "path", "type": "string", "required": true },
          { "name": "caption", "in": "formData", "type": "string", "required": false },
          { "name": "avatar", "in": "formData", "type": "file", "required": true }
        ],
        "responses": { "200": { "description": "uploaded" } }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "Create a session",
        "consumes": ["application/x-www-form-urlencoded"],
        "parameters": [
          { "name": "username", "in": "formData", "type": "string", "required": true },
          { "name": "password", "in": "formData", "type": "string", "required": true }
        ],
        "responses": { "200": { "description": "ok" } }
      }
    }
  }
}
