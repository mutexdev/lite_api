{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "node --test test/*.mts",
    "pretest": "node -e \"const fs=require('fs');const n=fs.existsSync('test')?fs.readdirSync('test').filter(f=>f.endsWith('.test.mts')).length:0;if(n<25){console.error('pretest: found '+n+' test files, expected at least 25. node --test EXITS 0 when its glob matches nothing, so a moved directory or a changed glob would leave CI green having run no tests at all. Fix the path, or lower this floor deliberately.');process.exit(1)}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "svelte-preprocess": "^6.0.3",
    "tslib": "^2.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "codemirror": "^6.0.2"
  }
}
